---
import SearchBox from "../components/SearchBox.astro";
import Layout from "../layouts/Layout.astro";

import { getDeviceCount } from "../io/device";
import { cachePolicy } from "../utilities/cache";

export const prerender = false;

const { total, caching } = await getDeviceCount();

Astro.cache.set({
	...cachePolicy(caching),
	tags: ["device-count"],
});
---

<Layout page="home">
	<div class="home-screen">
		<section class="hero">
			<div class="container hero-center">
				<h1>Find the right device for your smart home</h1>
				<p class="hero-lede">
					Real-world data from millions of Home Assistant installations
				</p>
				<div class="hero-search-wrap">
					<SearchBox size="hero" placeholder="Search" />
				</div>
				<div class="hero-actions">
					<a href="/browse">Browse all {total} devices →</a>
				</div>
			</div>
		</section>
	</div>
</Layout>
