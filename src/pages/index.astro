---
import SearchBox from "../components/SearchBox.astro";
import Layout from "../layouts/Layout.astro";

import { getDeviceCount } from "../io/device";
import { cachePolicy } from "../utilities/cache";
import { localize } from "../utilities/localize";

export const prerender = false;

const { total, caching } = await getDeviceCount();

Astro.cache.set({
	...cachePolicy(caching),
	tags: ["device-count"],
});
---

<Layout page="home">
	<div class="home-screen">
		<section class="hero">
			<div class="container hero-center">
				<h1>{localize("home.title")}</h1>
				<p class="hero-lede">{localize("home.lede")}</p>
				<div class="hero-search-wrap">
					<SearchBox
						size="hero"
						placeholder={localize("home.search_placeholder")}
					/>
				</div>
				<div class="hero-actions">
					<a href="/browse">{localize("home.browse_all", { count: total })}</a>
				</div>
			</div>
		</section>
	</div>
</Layout>
