---
import Layout from "../layouts/Layout.astro";

import surveyData from "../data/labs-survey-august-2026.json";

export const prerender = false;

Astro.cache.set({ maxAge: 86400 });

type Chart = {
	title: string;
	type: "bar" | "horizontal_bar" | "pie" | "contact_summary";
	data?: Record<string, number>;
	total_respondents?: number;
	likert_average?: number;
	is_likert?: boolean;
	contact_yes_percentage?: number;
};

const charts = surveyData.charts as Chart[];

const contributionChart = charts.find((chart) =>
	chart.title.includes("How likely are you to contribute"),
);
const regionChart = charts.find((chart) =>
	chart.title.includes("In what region"),
);

const regionTotal = Object.values(regionChart?.data ?? {}).reduce(
	(sum, value) => sum + value,
	0,
);
const europeShare = regionTotal
	? Math.round(((regionChart?.data?.Europe ?? 0) / regionTotal) * 100)
	: 0;

const title = "Labs survey - Update August, 2026";

const stats = [
	{ value: String(surveyData.total_responses), label: "Total responses" },
	{ value: String(charts.length), label: "Questions analysed" },
	{
		value: `${contributionChart?.likert_average ?? "-"}/5`,
		label: "Avg. contribution likelihood",
	},
	{ value: `${europeShare}%`, label: "Europe-based" },
];

// The survey ran in English and the questions are reproduced verbatim, so this
// page is deliberately not localised.
const chartMeta = (chart: Chart) =>
	[
		chart.total_respondents ? `${chart.total_respondents} responses` : null,
		chart.likert_average ? `Average: ${chart.likert_average}/5` : null,
	]
		.filter(Boolean)
		.join(" | ");
---

<Layout page="page" title={title}>
	<div class="container-narrow content-page">
		<section class="content-section content-intro">
			<h1>{title}</h1>
			<p class="content-lede">
				What 715 people told us they need from a device database, and what they
				are willing to contribute back.
			</p>
			<p class="content-prose">
				The Device Database Labs survey asked the Home Assistant community what
				smart home device information they look for, what is missing today, and
				whether they would help fill the gaps. This update covers 715 responses
				collected up to August 2026, 63 more than the first snapshot published
				in June.
			</p>
		</section>

		<section class="content-section">
			<dl class="survey-stats">
				{
					stats.map((stat) => (
						<div class="survey-stat">
							<dt class="survey-stat-value">{stat.value}</dt>
							<dd class="survey-stat-label">{stat.label}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section class="content-section">
			<h2>Key takeaways</h2>
			<p class="content-prose">
				<strong>Contribution readiness.</strong> Willingness to contribute stays exceptionally
				high: 94% rate themselves 4 or 5 out of 5, unchanged since June. Only 7% report
				no barriers at all, and the primary blocker remains time commitment (26% of
				all concerns raised), which points squarely at streamlined contribution workflows
				rather than persuasion.
			</p>
			<p class="content-prose">
				<strong>Community profile.</strong> Respondents are highly technical: 76%
				rate their technical comfort 4 or 5 out of 5, and 40% have run Home Assistant
				for four years or more. Half of all stated professional backgrounds are IT
				and system administration or software engineering. Every one of these values
				sits within a single point of the June snapshot.
			</p>
			<p class="content-prose">
				<strong>Why people contribute.</strong> Motivations are unchanged: supporting
				the Open Home Foundation and open-source projects (28%), getting useful information
				back in return (26%), and filling gaps in what is available today (22%). Building
				personal reputation ranks last, at roughly 1%.
			</p>
			<p class="content-prose">
				<strong>Critical information needs.</strong> Communication protocols (20%)
				and local control capabilities (19%) outrank every other device attribute.
				The largest gap people hit today is unclear compatibility information (16%),
				closely followed by thin detail on local control (15%), so the two align:
				the database is being asked for exactly what is hardest to find elsewhere.
			</p>
			<p class="content-prose">
				<strong>Usage patterns.</strong> The primary use case is pre-purchase research
				(30%). Beyond specifications, people ask for practical implementation support:
				device setup walkthroughs, integration code examples, and troubleshooting
				guides each draw around 17% of feature requests.
			</p>
			<p class="content-prose">
				<strong>Manufacturer engagement.</strong> Only 7 respondents identified as
				manufacturers, and no new manufacturer responses arrived since June, so these
				results represent the consumer and enthusiast perspective. Interest in a manufacturer
				verification programme holds at 3.91 out of 5, suggesting the appetite for
				official participation exists but has not yet been reached.
			</p>
			<p class="content-prose">
				<strong>Result stability.</strong> Adding 63 responses (a 10% increase) moved
				every headline metric by at most one percentage point. The June findings are
				confirmed rather than revised, and can now be treated as robust.
			</p>
		</section>

		<section class="content-section">
			<h2>What changed since June</h2>
			<p class="content-prose">
				Very little, which is itself the most useful finding. The sample grew
				from 652 to 715 responses and no headline number shifted by more than
				one percentage point. Where June left open the question of whether early
				respondents were unrepresentative enthusiasts, this update closes it:
				the picture is stable.
			</p>
			<p class="content-prose">
				Two things are worth watching. Manufacturer participation has not moved
				at all, so the manufacturer-facing questions still rest on 7 responses
				and should not be read as representative. And a small number of write-in
				answers now ask for programmatic access to the database over the Model
				Context Protocol, a request that did not appear in June.
			</p>
		</section>

		<section class="content-section">
			<h2>How to read these results</h2>
			<p class="content-prose">
				This was an opt-in survey promoted through Home Assistant community
				channels, so it describes people already invested in the ecosystem
				rather than smart home buyers in general. Three quarters of respondents
				are Europe-based, and the technical skew is pronounced. Where a question
				allowed several answers, percentages are shares of all selections made,
				not shares of respondents, so they sum across options rather than to
				100%.
			</p>
			<p class="content-prose">
				Free-text answers are summarised rather than published, and no personal
				data or email addresses are included in the results. 61% of respondents
				told us they are open to being contacted about future research.
			</p>
		</section>

		<section class="content-section">
			<h2>All questions</h2>
			<p class="content-prose">
				Every analysed question, in the order it was asked, with the number of
				responses behind each one. Questions that allowed several answers report
				shares of all selections made, so those charts sum to more than the
				number of respondents.
			</p>

			<div class="survey-charts" data-survey-charts>
				{
					charts.map((chart, index) => (
						<figure class="survey-chart">
							<figcaption>
								<h3 class="survey-chart-title">{chart.title}</h3>
								{(chart.total_respondents || chart.likert_average) && (
									<p class="survey-chart-meta">{chartMeta(chart)}</p>
								)}
							</figcaption>

							{chart.type === "contact_summary" ? (
								<div class="survey-contact">
									<p class="survey-contact-value">
										{chart.contact_yes_percentage}%
									</p>
									<p class="survey-contact-label">
										of respondents are open to being contacted
									</p>
								</div>
							) : (
								<div class="survey-chart-canvas" data-chart-index={index}>
									<canvas
										aria-label={chart.title}
										role="img"
										data-canvas-index={index}
									/>
								</div>
							)}
						</figure>
					))
				}
			</div>
		</section>
	</div>

	<script
		type="application/json"
		data-survey-data
		is:inline
		set:html={JSON.stringify(surveyData)}
	/>
</Layout>

<!--
	is:inline keeps this out of the Vite pipeline so Chart.js can be imported
	straight from the CDN as native ESM. The cost is that this file is plain JS,
	not TypeScript, and is not bundled or minified.
-->
<script is:inline type="module">
	const CHART_JS = "https://cdn.jsdelivr.net/npm/chart.js@4.4.0/auto/+esm";

	const PALETTE = [
		"#18BCF2",
		"#155E75",
		"#D98E2B",
		"#4E9F5A",
		"#B4556A",
		"#6C63C7",
		"#2FA39B",
		"#8A6FBF",
		"#C0762C",
		"#5A8FBF",
		"#7FA65A",
		"#B85C48",
		"#4C6C8C",
		"#9C8B5A",
		"#5AA6C8",
		"#8C5A7A",
		"#6B8E6B",
		"#A67C52",
		"#7A7669",
		"#4A4844",
	];

	const truncate = (value, max) =>
		value.length > max ? `${value.slice(0, max)}...` : value;

	const rendered = new Set();
	const instances = [];
	let observer;

	// The CDN module is only fetched once a chart is about to become visible, so
	// readers who never scroll that far never pay for it.
	let chartLibrary;
	async function loadChartLibrary() {
		if (!chartLibrary) {
			chartLibrary = import(CHART_JS).then((module) => module.default);
		}
		return chartLibrary;
	}

	function baseOptions() {
		return {
			responsive: true,
			maintainAspectRatio: false,
			plugins: {
				legend: { display: false },
				tooltip: {
					backgroundColor: "#11100F",
					cornerRadius: 8,
					padding: 16,
					titleFont: { size: 13, weight: "bold" },
					bodyFont: { size: 12 },
					titleMarginBottom: 10,
					bodySpacing: 6,
					boxWidth: 12,
					boxHeight: 12,
				},
			},
		};
	}

	function drawChart(Chart, canvas, info) {
		const entries = Object.entries(info.data ?? {});
		if (entries.length === 0) return;

		const keys = entries.map(([key]) => key);
		const values = entries.map(([, value]) => value);
		const options = baseOptions();

		if (info.type === "pie") {
			instances.push(
				new Chart(canvas, {
					type: "doughnut",
					data: {
						labels: keys,
						datasets: [
							{
								data: values,
								backgroundColor: PALETTE,
								borderWidth: 2,
								borderColor: "#fff",
							},
						],
					},
					options: {
						...options,
						cutout: "60%",
						plugins: {
							...options.plugins,
							legend: {
								display: true,
								position: "right",
								labels: {
									font: { size: 10 },
									padding: 8,
									boxWidth: 12,
									generateLabels(chart) {
										const dataset = chart.data.datasets[0];
										const total = dataset.data.reduce(
											(sum, value) => sum + value,
											0,
										);
										return chart.data.labels.map((label, i) => {
											const share = ((dataset.data[i] / total) * 100).toFixed(
												1,
											);
											return {
												text: `${truncate(label, 25)} (${share}%)`,
												fillStyle: PALETTE[i % PALETTE.length],
												hidden: false,
												index: i,
											};
										});
									},
								},
							},
							tooltip: {
								...options.plugins.tooltip,
								callbacks: {
									title: (context) => context[0].label,
									label: (context) => {
										const total = context.dataset.data.reduce(
											(sum, value) => sum + value,
											0,
										);
										const share = ((context.parsed / total) * 100).toFixed(1);
										return `Count: ${context.parsed} (${share}%)`;
									},
								},
							},
						},
					},
				}),
			);
			return;
		}

		const horizontal = info.type === "horizontal_bar";

		instances.push(
			new Chart(canvas, {
				type: "bar",
				data: {
					labels: keys,
					datasets: [
						{
							data: values,
							backgroundColor: horizontal ? PALETTE : PALETTE[0],
							borderWidth: 0,
							borderRadius: 6,
						},
					],
				},
				options: {
					...options,
					indexAxis: horizontal ? "y" : "x",
					plugins: {
						...options.plugins,
						tooltip: {
							...options.plugins.tooltip,
							callbacks: {
								title: (context) => context[0].label,
								label: (context) =>
									horizontal
										? `Responses: ${context.parsed.x}`
										: `Count: ${context.parsed.y}`,
							},
						},
					},
					scales: horizontal
						? {
								x: {
									beginAtZero: true,
									ticks: { precision: 0 },
									grid: { color: "rgba(0, 0, 0, 0.05)" },
								},
								y: {
									grid: { display: false },
									ticks: {
										font: { size: 10 },
										callback(value) {
											return truncate(this.getLabelForValue(Number(value)), 50);
										},
									},
								},
							}
						: {
								y: {
									beginAtZero: true,
									ticks: { precision: 0 },
									grid: { color: "rgba(0, 0, 0, 0.05)" },
								},
								x: {
									grid: { display: false },
									ticks: {
										callback(value) {
											return truncate(this.getLabelForValue(Number(value)), 20);
										},
									},
								},
							},
				},
			}),
		);
	}

	function init() {
		const container = document.querySelector("[data-survey-charts]");
		const dataScript = document.querySelector("[data-survey-data]");
		if (!container || !dataScript?.textContent) return;

		const surveyData = JSON.parse(dataScript.textContent);

		// 40+ canvases is a lot to initialise up front, so each one waits until it
		// is close to the viewport.
		observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;

					const canvas = entry.target;
					observer.unobserve(canvas);
					if (rendered.has(canvas)) continue;
					rendered.add(canvas);

					const info = surveyData.charts[Number(canvas.dataset.canvasIndex)];
					if (!info) continue;

					const wrapper = canvas.parentElement;
					if (wrapper && info.type === "horizontal_bar") {
						const rows = Object.keys(info.data ?? {}).length;
						wrapper.style.height = `${Math.max(300, rows * 35)}px`;
					}

					loadChartLibrary()
						.then((Chart) => drawChart(Chart, canvas, info))
						.catch(() => {
							container.dataset.chartsFailed = "true";
						});
				}
			},
			{ rootMargin: "300px 0px" },
		);

		for (const canvas of container.querySelectorAll(
			"canvas[data-canvas-index]",
		)) {
			observer.observe(canvas);
		}
	}

	function teardown() {
		observer?.disconnect();
		observer = undefined;
		rendered.clear();
		while (instances.length > 0) instances.pop()?.destroy();
	}

	// Inline scripts re-execute after a ClientRouter navigation, so the listeners
	// are registered only once.
	if (!window.__labsSurveyChartsBound) {
		window.__labsSurveyChartsBound = true;
		document.addEventListener("astro:page-load", init);
		document.addEventListener("astro:before-swap", teardown);
	}
</script>

<style>
	.survey-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 0;
		margin: 0;
		border-block: 1px solid color-mix(in srgb, currentColor 12%, transparent);
	}

	.survey-stat {
		padding: 1.5rem 1.5rem 1.5rem 0;
	}

	.survey-stat + .survey-stat {
		padding-inline-start: 1.5rem;
		border-inline-start: 1px solid
			color-mix(in srgb, currentColor 12%, transparent);
	}

	.survey-stat-value {
		font-size: 2rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.survey-stat-label {
		margin: 0.35rem 0 0;
		font-size: 0.875rem;
		opacity: 0.7;
	}

	.survey-charts {
		display: grid;
		gap: 1.5rem;
		margin-block-start: 2rem;
	}

	.survey-chart {
		margin: 0;
		padding: 1.75rem;
		border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
		border-radius: 12px;
	}

	.survey-chart-title {
		font-size: 1.1rem;
		line-height: 1.35;
		margin: 0;
	}

	.survey-chart-meta {
		margin: 0.35rem 0 0;
		font-size: 0.85rem;
		opacity: 0.7;
	}

	.survey-chart-canvas {
		position: relative;
		height: 400px;
		margin-block-start: 1.5rem;
	}

	.survey-contact {
		margin-block-start: 1.5rem;
		padding: 2.5rem 2rem;
		border-radius: 12px;
		background: color-mix(in srgb, currentColor 4%, transparent);
		text-align: center;
	}

	.survey-contact-value {
		margin: 0;
		font-size: 3.5rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1;
	}

	.survey-contact-label {
		margin: 0.6rem 0 0;
		opacity: 0.75;
	}

	@media (max-width: 40rem) {
		.survey-stat,
		.survey-stat + .survey-stat {
			padding: 1rem 0;
			border-inline-start: none;
		}

		.survey-stat + .survey-stat {
			border-block-start: 1px solid
				color-mix(in srgb, currentColor 12%, transparent);
		}

		.survey-chart {
			padding: 1.25rem;
		}

		.survey-chart-canvas {
			height: 320px;
		}
	}
</style>
