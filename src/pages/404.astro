---
import Layout from "../layouts/Layout.astro";

import { localizeHref } from "../paraglide/runtime.js";

// Like every other page: the locale comes from the request, so this cannot be
// prerendered. Prerendering it would resolve the locale at build time and send
// a base-locale page to everyone, whatever prefix they asked for.
export const prerender = false;
---

<Layout page="page" title="Page not found">
	<div class="container-narrow content-page">
		<section class="content-section content-intro">
			<h1>Page not found</h1>
			<p class="content-lede">
				Sorry, we couldn't find the page you were looking for.
			</p>
			<p class="content-prose">
				<a href={localizeHref("/")}>Return to the homepage</a>
			</p>
		</section>
	</div>

	<script is:inline>
		// Fired inline rather than from a document listener: the ClientRouter would
		// keep a listener alive after navigating away and report a 404 for the next
		// page too. PlausibleAnalytics.astro defines the queue stub in the head, so
		// the call is already safe to make here.
		if (typeof window.plausible === "function") window.plausible("404");
	</script>
</Layout>
