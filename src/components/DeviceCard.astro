---
import { localizeHref } from "../paraglide/runtime.js";
import { Unknown } from "../types/unknown";
import * as presentation from "../utilities/presentation";
import { PresentationRenderPresetRoleGlyph } from "../utilities/presentation/preset";
import type { DeviceCategoryTopLevelId } from "../types/category";
import type { DeviceCategoryId, DevicePoly } from "../types/device";

interface Props {
	device: DevicePoly;
	resolveCategory: (
		id: DeviceCategoryId | Unknown,
	) => DeviceCategoryTopLevelId | Unknown;
}

const { device, resolveCategory } = Astro.props;

const presentedConnectivity = presentation.device.connectivity(
	device.connectivity,
);
const resolvedCategories = [
	...new Set(device.categories?.map(resolveCategory) ?? []),
];
const presentedCategories = resolvedCategories.map((c) =>
	presentation.device.category(c),
);

const name = presentation.device.name(device);
---

<a class="device-row" href={localizeHref(`/devices/${device.id}`)}>
	<div
		class="device-thumb"
		set:html={presentation.render(
			presentation.device.category(resolvedCategories.at(0) ?? Unknown),
			PresentationRenderPresetRoleGlyph,
		)}
	/>
	<div class="device-row-body">
		<div>
			{
				presentedCategories.length > 0 &&
					presentedCategories.map((c) => (
						<div class="device-category">{c.label}</div>
					))
			}
		</div>
		<div class="device-name">{name}</div>
		<div class="device-manufacturer">{device.manufacturer}</div>
		<div>
			<span class={"local-indicator " + presentedConnectivity.cls}>
				<span class="dot"></span>
				{presentedConnectivity.label}
			</span>
		</div>
	</div>
</a>
